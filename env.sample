# Zou Backend API - Environment Configuration
# Copy to .env and customize before deployment
#
# Required variables are marked with [REQUIRED]
# Generate secrets with: openssl rand -hex 32

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# [REQUIRED] Secret key for JWT tokens and sessions
SECRET_KEY=

# [REQUIRED] Database password
DB_PASSWORD=

# =============================================================================
# DOCKER IMAGE
# =============================================================================

# Image name/tag to use (builds locally if not set)
# Example: registry.example.com/zou:v1.0.0
ZOU_IMAGE=zou:latest

# =============================================================================
# DATABASE
# =============================================================================

DB_USERNAME=postgres
DB_DATABASE=zoudb
DB_POOL_SIZE=30

# =============================================================================
# APPLICATION
# =============================================================================

# Your domain (without protocol) - used for email links, etc.
DOMAIN_NAME=zou.example.com
DOMAIN_PROTOCOL=https

# Exposed ports
ZOU_PORT=5000
ZOU_EVENTS_PORT=5001

# Debug mode (set to true for development)
DEBUG=false

# =============================================================================
# EMAIL (Optional - for notifications)
# =============================================================================

MAIL_ENABLED=false
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=noreply@example.com

# =============================================================================
# STORAGE PATHS (Optional - for separate disks/custom locations)
# =============================================================================

# By default, uses Docker named volumes. Set absolute paths to use bind mounts.
# Example: /mnt/ssd/postgres-data
POSTGRES_DATA_PATH=
# Example: /mnt/storage/zou-previews
PREVIEWS_PATH=
# Example: /mnt/fast-ssd/zou-tmp
TMP_PATH=
# Example: /path/to/plugins
PLUGINS_PATH=

# =============================================================================
# SEARCH (Optional - enable with --profile search)
# =============================================================================

# [REQUIRED if using search profile]
INDEXER_KEY=
INDEXER_HOST=meilisearch
INDEXER_PORT=7700

# =============================================================================
# SAML/SSO (Optional - for Single Sign-On)
# =============================================================================

# Enable SAML authentication
SAML_ENABLED=false

# Your Kitsu/Zou base URL for SAML metadata endpoint
SAML_ENTITY_ID=https://your-kitsu-domain/api/auth/saml/metadata

# Identity Provider (IdP) details - from your IdP metadata
# Example values shown are for Google Workspace
SAML_IDP_ENTITY_ID=https://accounts.google.com/o/saml2?idpid=YOUR_IDP_ID
SAML_IDP_SSO_URL=https://accounts.google.com/o/saml2/idp?idpid=YOUR_IDP_ID
SAML_IDP_SLO_URL=https://accounts.google.com/o/saml2/idp?idpid=YOUR_IDP_ID

# Path to the IdP certificate file (PEM format)
SAML_IDP_CERTIFICATE=/path/to/idp-certificate.pem

# Display name for the SSO button (e.g., "Google", "Okta", "Azure AD")
SAML_IDP_NAME=Google

# Auto-create users on first SSO login
SAML_AUTO_CREATE_USER=false
